          <string name="Name">Config</string>
          <string name="Source"><![CDATA[return {
    StartingCash = 5000,
    Genres = {"Pop", "Rock", "Hip-Hop", "Electronic", "Soul"},
    Locations = {"Open Mic", "Park Stage", "Music Cafe"},
    StudioCosts = {800, 1800, 4000},
    ScoutCosts = {600, 1600, 3000},
    Capacity = {1, 2, 4, 6},
    Minute = 60,
    MaxContractMinutes = 60,
}
]]></string>
