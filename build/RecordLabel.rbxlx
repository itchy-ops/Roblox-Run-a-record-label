      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[local Economy = {}
function Economy.ask(a)
    return math.floor(250 + a.popularity * 22 + a.members * 140)
end
function Economy.value(bonus, royalty, duration, promotion)
    return bonus + royalty * duration * 18 + promotion * 0.6
end
function Economy.accepts(a, terms)
    return Economy.value(terms.bonus, terms.royalty, terms.duration, terms.promotion)
        >= Economy.ask(a) * (0.65 + a.potential / 400)
end
function Economy.rate(a, studio, trend, roll)
    local event, multiplier = "Steady streams", 1
    if roll < 0.12 then event, multiplier = "New single underperformed", 0.2
    elseif roll > 0.94 then event, multiplier = "Viral hit!", 3
    elseif roll > 0.72 then event, multiplier = "Song gaining traction", 1.5 end
    local release = a.releaseUntil and a.releaseUntil > os.time() and 1.45 or 1
    local tour = a.tourUntil and a.tourUntil > os.time() and 1.3 or 1
    local promotion = 1 + math.min(1, a.contract.promotion / a.contract.duration / 100)
    local gross = (1 + a.popularity * 0.18) * (0.4 + a.skill / 100)
        * (0.65 + studio * 0.25) * trend * multiplier * release * tour * promotion
    local expense = a.members * 0.7 + a.contract.promotion / (a.contract.duration * 60)
    return gross * (1 - a.contract.royalty / 100) - expense, event
end
function Economy.range(potential, level)
    if level == 0 then return "Uncertain potential" end
    local width = ({25, 12, 4})[level]
    -- Fixed buckets do not leak the exact hidden stat through repeated scouting.
    local center = math.floor(potential / width) * width + math.floor(width / 2)
    return tostring(math.max(0, center - width)) .. "–" .. tostring(math.min(100, center + width))
end
return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Http = game:GetService("HttpService")
local Run = game:GetService("RunService")
local C = require(RS.Shared.Config)
local E = require(script.Parent.Economy)
local Store = require(script.Parent.ProfileStore)
local Trade = require(script.Parent.TradeStore)
local Settlement = require(script.Parent.Settlement)
local remote = Instance.new("RemoteFunction")
remote.Name = "LabelAction"; remote.Parent = RS
local profiles, sessions, lastRequest, bids, trends = {}, {}, {}, {}, {}
for _, genre in ipairs(C.Genres) do trends[genre] = 1 end
local function artist()
    local members = math.random(1, 5)
    local names = {"Velvet", "Neon", "Midnight", "Golden", "Static", "Silver", "Echo", "Lunar"}
    return {id = Http:GenerateGUID(false), name = names[math.random(#names)] .. " " .. (members == 1 and "Voice" or "Collective"),
        members = members, genre = C.Genres[math.random(#C.Genres)], popularity = math.random(5, 40),
        potential = math.random(20, 100), skill = math.random(25, 90), consistency = math.random(20, 95),
        motivation = math.random(40, 100), patience = 4, location = C.Locations[math.random(#C.Locations)],
        rate = 0, event = "Awaiting a release", experience = 0}
end
local function defaults()
    local p = {cash = C.StartingCash, studio = 0, scout = 0, artists = {}, messages = {"Welcome! Discover talent, sign a deal, and repair your studio."}}
    for _ = 1, 12 do table.insert(p.artists, artist()) end
    return p
end
local function note(p, message)
    table.insert(p.messages, 1, message)
    while #p.messages > 20 do table.remove(p.messages) end
end
local function find(p, id)
    for i, a in ipairs(p.artists) do if a.id == id then return a, i end end
end
local function count(p)
    local n = 0
    for _, a in ipairs(p.artists) do if a.contract then n = n + 1 end end
    return n
end
local function spend(p, cost)
    if p.cash < cost then error("Not enough cash.", 0) end
    p.cash = p.cash - cost
end
local function number(v, low, high)
    if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge or v < low or v > high then
        error("Enter a number between " .. low .. " and " .. high .. ".", 0)
    end
    return math.floor(v)
end
local function publicArtist(a, p)
    return {id = a.id, name = a.name, genre = a.genre, members = a.members, popularity = math.floor(a.popularity),
        potential = E.range(a.potential, a.scouted and p.scout or 0), location = a.location,
        skill = a.scouted and (a.skill >= 65 and "Strong" or "Developing") or "Unscouted",
        motivation = a.motivation >= 65 and "Driven" or "Reserved", consistency = a.experience >= 3 and a.consistency or "Unknown",
        contract = a.contract, rate = a.rate, event = a.event, asking = E.ask(a),
        patience = a.patience, blockedUntil = a.blockedUntil, buyout = a.buyout}
end
local function snapshot(player)
    local p = profiles[player]; if not p then return nil end
    local result = {cash = math.floor(p.cash), studio = p.studio, scout = p.scout, capacity = C.Capacity[p.studio + 1],
        messages = p.messages, artists = {}, trends = trends, marketplace = {}, bids = {}, saving = sessions[player].persistent,
        studioCost = C.StudioCosts[p.studio + 1], scoutCost = C.ScoutCosts[p.scout + 1],
        playerTrades = true}
    for _, a in ipairs(p.artists) do
        if a.discovered or a.contract then table.insert(result.artists, publicArtist(a, p)) end
    end
    for other, otherP in pairs(profiles) do
        if other ~= player then
            for _, a in ipairs(otherP.artists) do
                if a.contract then table.insert(result.marketplace, {id = a.id, owner = other.UserId, label = other.DisplayName,
                    name = a.name, popularity = math.floor(a.popularity), contract = a.contract}) end
            end
        end
    end
    for id, b in pairs(bids) do
        if b.seller == player then table.insert(result.bids, {id = id, name = b.name, amount = b.amount, buyer = b.buyer.DisplayName}) end
    end
    return result
end
local function action(player, verb, args)
    local p = profiles[player]
    if not p then error("Profile is still loading.", 0) end
    if sessions[player].frozen then error("Saving unavailable. Rejoin later.", 0) end
    if sessions[player].trading and verb ~= "State" then error("A transfer is settling. Please wait.", 0) end
    args = type(args) == "table" and args or {}
    if verb == "State" then return end
    if verb == "Discover" then
        local n = 0
        for _, a in ipairs(p.artists) do
            if not a.discovered then a.discovered = true; n = n + 1 end
            if n == 3 then break end
        end
        note(p, n > 0 and "Your social feed found " .. n .. " new artists." or "All local artists discovered."); return
    end
    if verb == "Studio" or verb == "ScoutUpgrade" then
        local field = verb == "Studio" and "studio" or "scout"
        local costs = verb == "Studio" and C.StudioCosts or C.ScoutCosts
        local cost = costs[p[field] + 1]
        if not cost then error("Fully upgraded.", 0) end
        spend(p, cost); p[field] = p[field] + 1
        note(p, field .. " upgraded to level " .. p[field]); return
    end
    if verb == "Bid" then
        local seller = Players:GetPlayerByUserId(number(args.owner, -1e16, 1e16))
        if not seller or seller == player or not profiles[seller] or sessions[seller].frozen then error("Seller unavailable.", 0) end
        if sessions[seller].persistent ~= sessions[player].persistent then error("Cannot trade between practice and saved labels.", 0) end
        local a = find(profiles[seller], args.id)
        if not a or not a.contract then error("Contract unavailable.", 0) end
        local amount = number(args.amount, 1, 10000000)
        if p.cash < amount then error("Not enough cash.", 0) end
        -- One outstanding offer per buyer keeps the inbox bounded.
        for id, b in pairs(bids) do if b.buyer == player then bids[id] = nil end end
        bids[Http:GenerateGUID(false)] = {buyer = player, seller = seller, artist = a.id, name = a.name, amount = amount, expires = os.time() + 120}
        note(profiles[seller], player.DisplayName .. " offered $" .. amount .. " for " .. a.name); return
    end
    if verb == "AcceptBid" or verb == "RejectBid" then
        local b = bids[args.id]
        if not b or b.seller ~= player then error("Offer unavailable.", 0) end
        if verb == "RejectBid" then bids[args.id] = nil; return end
        local buyerP = profiles[b.buyer]
        local a, index = find(p, b.artist)
        if b.expires < os.time() or not buyerP or not a or not a.contract or a.contract.expires <= os.time() then
            bids[args.id] = nil; error("Offer expired.", 0)
        end
        if count(buyerP) >= C.Capacity[buyerP.studio + 1] then error("Buyer has no studio space.", 0) end
        local buyerS, sellerS = sessions[b.buyer], sessions[player]
        if not buyerS or buyerS.frozen or buyerS.trading or buyerS.saving or sellerS.saving then error("Labels are busy. Try again.", 0) end
        if buyerP.cash < b.amount then error("Buyer no longer has enough cash.", 0) end
        if buyerS.persistent ~= sellerS.persistent then error("Incompatible save modes.", 0) end
        if not sellerS.persistent then
            spend(buyerP, b.amount); p.cash = p.cash + b.amount
            table.remove(p.artists, index); a.buyout = nil; table.insert(buyerP.artists, a)
        else
            -- Block actions, career updates, disconnect saves, and autosaves until
            -- both reservations are durable and the journal decision is known.
            buyerS.trading, sellerS.trading = true, true
            local id = Trade.begin(b.buyer.UserId, player.UserId)
            if not id then
                buyerS.trading, sellerS.trading = false, false
                error("Trade storage unavailable. No funds moved.", 0)
            end
            a.buyout = nil
            p.escrows = p.escrows or {}; buyerP.escrows = buyerP.escrows or {}
            local copy = Http:JSONDecode(Http:JSONEncode(a))
            p.escrows[id] = {role = "seller", amount = b.amount, artist = copy}
            buyerP.escrows[id] = {role = "buyer", amount = b.amount, artist = copy}
            table.remove(p.artists, index); spend(buyerP, b.amount)
            local sellerSaved = Store.save(player.UserId, Http:JSONDecode(Http:JSONEncode(p)), false)
            local buyerSaved = sellerSaved and Store.save(b.buyer.UserId, Http:JSONDecode(Http:JSONEncode(buyerP)), false)
            local status = Trade.finish(id, sellerSaved and buyerSaved and "committed" or "aborted")
            if not status then status = Trade.status(id) end
            if status ~= "committed" and status ~= "aborted" then
                buyerS.frozen, sellerS.frozen = true, true
                buyerS.trading, sellerS.trading = false, false
                bids[args.id] = nil
                b.buyer:Kick("Transfer recovery required. Rejoin in three minutes.")
                player:Kick("Transfer recovery required. Rejoin in three minutes.")
                error("Transfer decision unavailable. Reserved assets will recover on rejoin.", 0)
            end
            Settlement.apply(p, id, status); Settlement.apply(buyerP, id, status)
            local finalSeller = Store.save(player.UserId, Http:JSONDecode(Http:JSONEncode(p)), false)
            local finalBuyer = Store.save(b.buyer.UserId, Http:JSONDecode(Http:JSONEncode(buyerP)), false)
            buyerS.trading, sellerS.trading = false, false
            bids[args.id] = nil
            if not finalSeller or not finalBuyer then
                -- Replaying from a durable escrow on next load applies the same
                -- terminal decision once; do not allow subsequent mutations now.
                buyerS.frozen, sellerS.frozen = true, true
                b.buyer:Kick("Transfer saved in recovery journal. Please rejoin shortly.")
                player:Kick("Transfer saved in recovery journal. Please rejoin shortly.")
                error("Transfer requires save recovery on rejoin.", 0)
            end
            buyerS.lastSaved, sellerS.lastSaved = os.time(), os.time()
            if status == "aborted" then error("Transfer aborted; reserved funds and artist restored.", 0) end
        end
        bids[args.id] = nil
        note(p, "Sold " .. a.name .. " for $" .. b.amount)
        note(buyerP, "Acquired " .. a.name .. " with its remaining contract."); return
    end
    local a, index = find(p, args.id)
    if not a or not a.discovered then error("Artist unavailable.", 0) end
    if verb == "Scout" then
        spend(p, 100); a.scouted = true
        note(p, "Scouting: " .. a.name .. " — " .. E.range(a.potential, p.scout)); return
    end
    if verb == "Negotiate" then
        if a.contract then error("Already signed.", 0) end
        if a.blockedUntil and a.blockedUntil > os.time() then error("Artist cooling off. Try again later.", 0) end
        if a.patience <= 0 then a.patience = 4 end
        if count(p) >= C.Capacity[p.studio + 1] then error("Upgrade your studio for more space.", 0) end
        local t = {bonus = number(args.bonus, 0, 1000000), royalty = number(args.royalty, 0, 80),
            duration = number(args.duration, 5, C.MaxContractMinutes), promotion = number(args.promotion, 0, 1000000)}
        if p.cash < t.bonus + t.promotion then error("Cannot fund bonus and promotion commitment.", 0) end
        if E.accepts(a, t) then
            spend(p, t.bonus + t.promotion); t.expires = os.time() + t.duration * 60
            a.contract = t; a.buyout = nil
            note(p, a.name .. " signed! Record a single to build their audience.")
        else
            a.patience = a.patience - 1
            if a.patience == 0 then a.blockedUntil = os.time() + 120 end
            note(p, a.name .. ": Offer too low. Increase bonus, royalty, or promotion. Patience: " .. a.patience)
        end
        return
    end
    if not a.contract or a.contract.expires <= os.time() then error("Active contract required.", 0) end
    if verb == "Single" or verb == "Album" or verb == "Tour" or verb == "Promote" then
        if p.studio == 0 and verb ~= "Promote" then error("Repair your studio first.", 0) end
        if a.releaseUntil and a.releaseUntil > os.time() and (verb == "Single" or verb == "Album") then error("Release already in progress.", 0) end
        if verb == "Tour" and a.tourUntil and a.tourUntil > os.time() then error("Already touring.", 0) end
        local costs = {Single = 200, Album = 650, Tour = 450, Promote = 250}
        spend(p, costs[verb])
        if verb == "Tour" then a.tourUntil = os.time() + 180
        elseif verb ~= "Promote" then a.releaseUntil = os.time() + (verb == "Album" and 300 or 120) end
        a.popularity = math.min(100, a.popularity + (verb == "Album" and 8 or 3))
        a.event = verb .. " campaign launched"; note(p, a.name .. ": " .. a.event); return
    end
    if verb == "AcceptAI" then
        if not a.buyout or a.buyout.expires <= os.time() then error("Buyout expired.", 0) end
        p.cash = p.cash + a.buyout.amount
        note(p, a.name .. " sold to " .. a.buyout.label .. " for $" .. a.buyout.amount)
        table.remove(p.artists, index); table.insert(p.artists, artist()); return
    end
    if verb == "RejectAI" then a.buyout = nil; return end
    error("Unknown action.", 0)
end
remote.OnServerInvoke = function(player, verb, args)
    local now = os.clock()
    if now - (lastRequest[player] or 0) < 0.15 then return {ok = false, message = "Please wait a moment."} end
    lastRequest[player] = now
    local ok, err = pcall(action, player, verb, args)
    return {ok = ok, message = not ok and tostring(err) or nil, state = snapshot(player)}
end
Players.PlayerAdded:Connect(function(player)
    local p, persistent = Store.load(player.UserId, defaults())
    if not p then player:Kick("Your label could not be safely loaded. Rejoin in a few minutes."); return end
    if player.Parent ~= Players then if persistent then Store.save(player.UserId, p, true) end; return end
    profiles[player] = p; sessions[player] = {persistent = persistent, lastSaved = os.time()}
    for _, a in ipairs(p.artists) do a.rate = 0 end
end)
local function save(player, release)
    local p, s = profiles[player], sessions[player]
    if not p or not s or not s.persistent then return end
    if s.trading then
        if release then while s.trading do task.wait(0.1) end else return end
    end
    if s.saving then
        if release then while s.saving do task.wait(0.1) end else return end
    end
    s.saving = true
    local copy = Http:JSONDecode(Http:JSONEncode(p))
    local ok = Store.save(player.UserId, copy, release)
    s.saving = false
    if ok then s.lastSaved = os.time()
    elseif os.time() - s.lastSaved > 100 then s.frozen = true; player:Kick("Saving unavailable. Rejoin later to protect progress.") end
end
Players.PlayerRemoving:Connect(function(player)
    save(player, true)
    profiles[player], sessions[player], lastRequest[player] = nil, nil, nil
    for id, b in pairs(bids) do if b.buyer == player or b.seller == player then bids[id] = nil end end
end)
game:BindToClose(function()
    local pending = 0
    for player in pairs(profiles) do pending = pending + 1; task.spawn(function() save(player, true); pending = pending - 1 end) end
    while pending > 0 do task.wait(0.1) end
end)
local function career(p, a)
    a.experience = a.experience + 1
    local roll = math.random()
    local growth = a.potential / 100 * a.motivation / 100 * 2 + (roll - 0.55) * (5 - a.consistency / 25)
    a.popularity = math.clamp(a.popularity + growth, 0, 100)
    a.rate, a.event = E.rate(a, p.studio, trends[a.genre], roll)
    -- Promotion is reserved on signing; avoid charging the amortized cost twice.
    a.rate = a.rate + a.contract.promotion / (a.contract.duration * 60)
    if a.popularity >= 50 and not a.buyout and math.random() < 0.35 then
        a.buyout = {amount = math.floor(E.ask(a) * (2 + math.random() * 3)), label = "Horizon Records", expires = os.time() + 120}
        note(p, "Horizon Records wants " .. a.name .. "! Check your offers.")
    end
end
task.spawn(function()
    local last, elapsed, autosave = os.clock(), 60, 0
    while true do
        task.wait(1)
        local now = os.clock()
        local delta = math.min(now - last, 5); last = now
        elapsed, autosave = elapsed + delta, autosave + delta
        local refresh = elapsed >= 60
        if refresh then elapsed = 0; for _, g in ipairs(C.Genres) do trends[g] = math.random(70, 140) / 100 end end
        for player, p in pairs(profiles) do
            if not sessions[player].frozen and not sessions[player].trading then
                for _, a in ipairs(p.artists) do
                    if a.buyout and a.buyout.expires <= os.time() then a.buyout = nil end
                    if a.contract then
                        if a.contract.expires <= os.time() then
                            a.contract, a.buyout, a.rate = nil, nil, 0; a.patience = 4
                            note(p, a.name .. "'s contract expired. Negotiate again.")
                        else
                            if refresh then career(p, a) end
                            p.cash = math.max(-10000, p.cash + a.rate * delta)
                        end
                    end
                end
                if p.cash < 100 and count(p) == 0 then p.cash = p.cash + 5 * delta end
            end
            if autosave >= 45 then task.spawn(save, player, false) end
        end
        if autosave >= 45 then autosave = 0 end
        for id, bid in pairs(bids) do if bid.expires <= os.time() then bids[id] = nil end end
    end
end)
-- The town is serialized in Workspace, so it also appears in Studio edit mode.
local town = workspace:WaitForChild("Town")
for index, name in ipairs({"Your Studio", "Open Mic", "Park Stage", "Music Cafe"}) do
    local booth = town:WaitForChild(name .. " booth")
    local prompt = booth:WaitForChild("ProximityPrompt")
    prompt.Triggered:Connect(function(player)
        local p = profiles[player]; if not p then return end
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not root or (root.Position - booth.Position).Magnitude > 15 then return end
        if index == 1 then
            note(p, "Studio level " .. p.studio .. ". Open your phone to repair and manage artists.")
            return
        end
        local n = 0
        for _, a in ipairs(p.artists) do
            if a.location == name and not a.discovered then a.discovered = true; n = n + 1 end
        end
        note(p, "Discovered " .. n .. " artists at " .. name .. ". Open your phone.")
    end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local store
local function getStore()
    if not store then store = DataStoreService:GetDataStore("RecordLabel_v1") end
    return store
end
local Trade = require(script.Parent.TradeStore)
local Settlement = require(script.Parent.Settlement)
local Store = {}
local session = game.JobId ~= "" and game.JobId or HttpService:GenerateGUID(false)
local function key(id) return "player_" .. id end
function Store.load(id, defaults)
    local result
    local ok, err = pcall(function()
        result = getStore():UpdateAsync(key(id), function(old)
            if old and old.lock and old.lock.session ~= session and old.lock.expires > os.time() then
                return nil
            end
            local data = old and old.data or defaults
            return {data = data, lock = {session = session, expires = os.time() + 180}}
        end)
    end)
    if ok and result then
        local data = result.data
        for id in pairs(data.escrows or {}) do
            local status = Trade.status(id)
            if status ~= "committed" and status ~= "aborted" then
                warn("Trade recovery unavailable; refusing profile load", id)
                return nil, false
            end
            Settlement.apply(data, id, status)
        end
        if not Store.save(id, data, false) then return nil, false end
        return data, true
    end
    if RunService:IsStudio() and not ok then
        warn("DataStore unavailable: Studio practice mode; progress will not save.")
        return defaults, false
    end
    warn("Profile load refused", id, tostring(err))
    return nil, false
end
function Store.save(id, data, release)
    local result
    local ok, err = pcall(function()
        result = getStore():UpdateAsync(key(id), function(old)
            if not old or not old.lock or old.lock.session ~= session then return nil end
            return {data = data, lock = not release and {session = session, expires = os.time() + 180} or nil}
        end)
    end)
    if not ok then warn("Profile save failed", id, tostring(err)) end
    return ok and result ~= nil
end
return Store
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Settlement</string>
          <string name="Source"><![CDATA[-- Idempotent settlement through saved escrow records. Removing an escrow and applying
-- its result are persisted together in one profile UpdateAsync.
local Settlement = {}
function Settlement.apply(profile, id, status)
    local escrow = profile.escrows and profile.escrows[id]
    if not escrow then return false end
    assert(status == "committed" or status == "aborted", "Settlement must be terminal")
    local receiveArtist = (status == "committed" and escrow.role == "buyer")
        or (status == "aborted" and escrow.role == "seller")
    if receiveArtist then
        local exists = false
        for _, a in ipairs(profile.artists) do if a.id == escrow.artist.id then exists = true end end
        if not exists then table.insert(profile.artists, escrow.artist) end
    else
        profile.cash = profile.cash + escrow.amount
    end
    profile.escrows[id] = nil
    return true
end
return Settlement
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">TradeStore</string>
          <string name="Source"><![CDATA[-- A durable journal coordinates two independently saved profiles. Funds and the
-- artist are reserved before commitment; profile loading resolves interrupted trades.
local DS = game:GetService("DataStoreService")
local Http = game:GetService("HttpService")
local journal
local function getJournal()
    if not journal then journal = DS:GetDataStore("RecordLabel_trades_v1") end
    return journal
end
local Trade = {}
function Trade.begin(buyer, seller)
    local id = Http:GenerateGUID(false)
    local ok, result = pcall(function()
        return getJournal():UpdateAsync(id, function(old)
            if old then return nil end
            return {status = "pending", buyer = buyer, seller = seller, expires = os.time() + 120}
        end)
    end)
    if ok and result then return id end
    return nil
end
function Trade.finish(id, desired)
    local ok, result = pcall(function()
        return getJournal():UpdateAsync(id, function(old)
            if not old then return nil end
            if old.status == "pending" then
                old.status = desired == "committed" and old.expires > os.time() and "committed" or "aborted"
            end
            return old
        end)
    end)
    return ok and result and result.status or nil
end
function Trade.status(id)
    local ok, result = pcall(function() return getJournal():GetAsync(id) end)
    if not ok or not result then return nil end
    if result.status == "pending" and result.expires <= os.time() then return Trade.finish(id, "aborted") end
    return result.status
end
return Trade
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">World</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Independent map startup: this script never requires profile or DataStore modules.
local Players = game:GetService("Players")
local mapVersion = "Map fix 3"
local definitions = {{name="Town Ground",size={240,1,240},position={0,-1,0},color={63,91,77},kind="Part"},{name="Main Street",size={22,0.2,200},position={0,-0.35,0},color={42,44,54},kind="Part"},{name="Town Spawn",size={8,1,8},position={0,1,65},color={112,82,213},kind="SpawnLocation"},{name="Your Studio",size={30,1,26},position={-40,0,45},color={85,62,94},kind="Part"},{name="Your Studio rear wall",size={30,12,1},position={-40,6,32},color={44,49,65},kind="Part"},{name="Your Studio left wall",size={1,12,26},position={-55,6,45},color={44,49,65},kind="Part"},{name="Your Studio right wall",size={1,12,26},position={-25,6,45},color={44,49,65},kind="Part"},{name="Your Studio path",size={18,0.2,8},position={-20,-0.25,53},color={140,143,151},kind="Part"},{name="Your Studio booth",size={5,3,3},position={-40,2,38},color={117,82,165},kind="Part"},{name="Battered mixing desk",size={8,2,4},position={-47,2,48},color={75,65,57},kind="Part"},{name="Old microphone",size={0.4,5,0.4},position={-33,3,45},color={105,105,105},kind="Part"},{name="Open Mic",size={30,1,26},position={40,0,25},color={105,62,94},kind="Part"},{name="Open Mic rear wall",size={30,12,1},position={40,6,12},color={44,49,65},kind="Part"},{name="Open Mic left wall",size={1,12,26},position={25,6,25},color={44,49,65},kind="Part"},{name="Open Mic right wall",size={1,12,26},position={55,6,25},color={44,49,65},kind="Part"},{name="Open Mic path",size={18,0.2,8},position={20,-0.25,33},color={140,143,151},kind="Part"},{name="Open Mic booth",size={5,3,3},position={40,2,18},color={117,82,165},kind="Part"},{name="Open Mic stage",size={12,1,6},position={40,1,21},color={94,82,115},kind="Part"},{name="Park Stage",size={30,1,26},position={-40,0,-25},color={125,62,94},kind="Part"},{name="Park Stage rear wall",size={30,12,1},position={-40,6,-38},color={44,49,65},kind="Part"},{name="Park Stage left wall",size={1,12,26},position={-55,6,-25},color={44,49,65},kind="Part"},{name="Park Stage right wall",size={1,12,26},position={-25,6,-25},color={44,49,65},kind="Part"},{name="Park Stage path",size={18,0.2,8},position={-20,-0.25,-17},color={140,143,151},kind="Part"},{name="Park Stage booth",size={5,3,3},position={-40,2,-32},color={117,82,165},kind="Part"},{name="Park Stage stage",size={12,1,6},position={-40,1,-29},color={94,82,115},kind="Part"},{name="Music Cafe",size={30,1,26},position={40,0,-55},color={145,62,94},kind="Part"},{name="Music Cafe rear wall",size={30,12,1},position={40,6,-68},color={44,49,65},kind="Part"},{name="Music Cafe left wall",size={1,12,26},position={25,6,-55},color={44,49,65},kind="Part"},{name="Music Cafe right wall",size={1,12,26},position={55,6,-55},color={44,49,65},kind="Part"},{name="Music Cafe path",size={18,0.2,8},position={20,-0.25,-47},color={140,143,151},kind="Part"},{name="Music Cafe booth",size={5,3,3},position={40,2,-62},color={117,82,165},kind="Part"},{name="Music Cafe stage",size={12,1,6},position={40,1,-59},color={94,82,115},kind="Part"}}
local locations = {"Your Studio", "Open Mic", "Park Stage", "Music Cafe"}
local town = workspace:FindFirstChild("Town")
local function validMap(model)
    if not model then return false end
    for _, d in ipairs(definitions) do
        local p = model:FindFirstChild(d.name)
        if not p or not p:IsA("BasePart") then return false end
    end
    return true
end
local repaired = not validMap(town)
if not town then
    town = Instance.new("Model")
    town.Name = "Town"
    town.Parent = workspace
end
for _, d in ipairs(definitions) do
    local p = town:FindFirstChild(d.name)
    if p and not p:IsA("BasePart") then
        warn("RecordLabel map name collision: " .. d.name)
        p.Name = d.name .. " preserved"
        p = nil
    end
    if not p then
        p = Instance.new(d.kind)
        p.Name = d.name
        p.Parent = town
    end
    p.Anchored = true
    p.CanCollide = true
    p.Transparency = 0
    p.Size = Vector3.new(d.size[1], d.size[2], d.size[3])
    p.CFrame = CFrame.new(d.position[1], d.position[2], d.position[3])
    p.Color = Color3.fromRGB(d.color[1], d.color[2], d.color[3])
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    if d.kind == "SpawnLocation" then p.Enabled = true; p.Neutral = true; p.Duration = 0 end
end
for index, name in ipairs(locations) do
    local booth = town:FindFirstChild(name .. " booth")
    local prompt = booth:FindFirstChild("ProximityPrompt")
    if not prompt then prompt = Instance.new("ProximityPrompt"); prompt.Name = "ProximityPrompt"; prompt.Parent = booth end
    prompt.Enabled = true
    prompt.ActionText = index == 1 and "Check studio" or "Discover local talent"
    prompt.ObjectText = name
    prompt.MaxActivationDistance = 10
    local floor = town:FindFirstChild(name)
    if not floor:FindFirstChild("Location Sign") then
        local sign = Instance.new("BillboardGui")
        sign.Name = "Location Sign"; sign.Size = UDim2.fromOffset(220, 50)
        sign.StudsOffset = Vector3.new(0, 13, 0); sign.AlwaysOnTop = true; sign.Parent = floor
        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1); label.BackgroundTransparency = 1
        label.Text = name; label.TextColor3 = Color3.new(1, 1, 1); label.TextScaled = true; label.Parent = sign
    end
end
local spawn = town:FindFirstChild("Town Spawn")
town:SetAttribute("MapVersion", mapVersion)
-- Use this map's spawn explicitly, including for players already present at startup.
local function bind(player)
    player.RespawnLocation = spawn
    local function characterReady(character)
        local root = character:WaitForChild("HumanoidRootPart", 10)
        if not root or player.Character ~= character then return end
        if repaired or root.Position.Y < -10 or math.abs(root.Position.X) > 110 or math.abs(root.Position.Z) > 110 then
            character:PivotTo(spawn.CFrame * CFrame.new(0, 5, 0))
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end
    player.CharacterAdded:Connect(characterReady)
    if player.Character then task.spawn(characterReady, player.Character) end
end
Players.PlayerAdded:Connect(bind)
for _, player in ipairs(Players:GetPlayers()) do bind(player) end
print("RecordLabel " .. mapVersion .. ": " .. #definitions .. " anchored map parts ready; spawn at (0, 1, 65).")
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="12">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="13">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Phone</string>
        </Properties>
        <Item class="LocalScript" referent="15">
          <Properties>
            <string name="Name">Phone</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local remote = RS:WaitForChild("LabelAction")
local gui = Instance.new("ScreenGui")
gui.Name = "LabelPhone"; gui.ResetOnSpawn = false; gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
local colors = {bg = Color3.fromRGB(19, 23, 35), card = Color3.fromRGB(31, 37, 53), accent = Color3.fromRGB(112, 82, 213), text = Color3.fromRGB(236, 239, 248)}
local function corner(obj) local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 10); c.Parent = obj end
local function label(parent, text, height)
    local v = Instance.new("TextLabel")
    v.Size = UDim2.new(1, 0, 0, height or 32); v.BackgroundTransparency = 1
    v.Text = text; v.TextColor3 = colors.text; v.TextSize = 15; v.Font = Enum.Font.Gotham
    v.TextWrapped = true; v.TextXAlignment = Enum.TextXAlignment.Left; v.Parent = parent
    return v
end
local function button(parent, text, fn)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 36); b.BackgroundColor3 = colors.accent
    b.TextColor3 = colors.text; b.TextSize = 14; b.Font = Enum.Font.GothamMedium; b.Text = text; b.Parent = parent
    corner(b); b.Activated:Connect(fn); return b
end
local frame = Instance.new("Frame")
frame.Size = UDim2.fromScale(0.9, 0.82); frame.Position = UDim2.fromScale(0.5, 0.5); frame.AnchorPoint = Vector2.new(0.5, 0.5)
frame.BackgroundColor3 = colors.bg; frame.Parent = gui; corner(frame)
local constraint = Instance.new("UISizeConstraint")
constraint.MaxSize = Vector2.new(740, 820); constraint.Parent = frame
local padding = Instance.new("UIPadding")
padding.PaddingLeft = UDim.new(0, 14); padding.PaddingRight = UDim.new(0, 14); padding.Parent = frame
local title = label(frame, "RECORD LABEL  /  FROM NOTHING", 36)
local status = label(frame, "Loading your label…", 46); status.Position = UDim2.fromOffset(0, 36)
local notice = label(frame, "Explore town or use your social feed to discover talent.", 42); notice.Position = UDim2.fromOffset(0, 82)
local tabs = Instance.new("Frame")
tabs.Size = UDim2.new(1, 0, 0, 38); tabs.Position = UDim2.fromOffset(0, 126); tabs.BackgroundTransparency = 1; tabs.Parent = frame
local tabLayout = Instance.new("UIListLayout")
tabLayout.FillDirection = Enum.FillDirection.Horizontal; tabLayout.Padding = UDim.new(0, 4); tabLayout.Parent = tabs
local content = Instance.new("ScrollingFrame")
content.Position = UDim2.fromOffset(0, 176); content.Size = UDim2.new(1, 0, 1, -190)
content.BackgroundTransparency = 1; content.BorderSizePixel = 0; content.ScrollBarThickness = 5
content.AutomaticCanvasSize = Enum.AutomaticSize.Y; content.CanvasSize = UDim2.new(); content.Parent = frame
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 10); layout.SortOrder = Enum.SortOrder.LayoutOrder; layout.Parent = content
local toggle = button(gui, "Phone [P]", function() frame.Visible = not frame.Visible end)
toggle.Size = UDim2.fromOffset(120, 36); toggle.Position = UDim2.new(1, -132, 0, 12)
UIS.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.P then frame.Visible = not frame.Visible end
end)
local state, tab, busy, drafts = nil, "Feed", false, {}
local render
local function request(verb, args, redraw)
    if busy then return end
    busy = true
    local ok, response = pcall(function() return remote:InvokeServer(verb, args) end)
    busy = false
    if not ok then notice.Text = "Connection interrupted. Try again."; return end
    if response.state then state = response.state end
    if not response.ok then notice.Text = response.message or "Action failed."
    elseif verb ~= "State" then notice.Text = state and state.messages[1] or "Done." end
    if state then
        local desk = workspace:FindFirstChild("Battered mixing desk", true)
        if desk then desk.Color = state.studio > 0 and Color3.fromRGB(102, 91, 173) or Color3.fromRGB(75, 65, 57) end
        status.Text = string.format("$%s  |  Studio %d  |  Scouting %d  |  Slots %d\n%s", state.cash, state.studio, state.scout, state.capacity,
            state.saving and "Progress saving enabled" or "PRACTICE MODE — progress will not save")
    end
    if redraw and render then render() end
end
local function card()
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -8, 0, 0); f.AutomaticSize = Enum.AutomaticSize.Y
    f.BackgroundColor3 = colors.card; f.Parent = content; corner(f)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, 10); p.PaddingBottom = UDim.new(0, 10)
    p.PaddingLeft = UDim.new(0, 10); p.PaddingRight = UDim.new(0, 10); p.Parent = f
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, 6); l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = f
    return f
end
local function field(parent, caption, initial, callback)
    label(parent, caption, 24)
    local input = Instance.new("TextBox")
    input.Size = UDim2.new(1, 0, 0, 34); input.BackgroundColor3 = colors.bg
    input.TextColor3 = colors.text; input.Font = Enum.Font.Gotham; input.TextSize = 15
    input.ClearTextOnFocus = false; input.Text = tostring(initial); input.Parent = parent; corner(input)
    input.FocusLost:Connect(function() callback(input.Text) end)
    return input
end
local function artistCard(a)
    local f = card()
    label(f, a.name .. "  /  " .. a.genre .. "  /  " .. a.members .. " member(s)", 36)
    label(f, "Popularity " .. a.popularity .. "/100  •  " .. a.potential, 36)
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, 0, 0, 7); bar.BackgroundColor3 = colors.bg; bar.Parent = f; corner(bar)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(a.popularity / 100, 1); fill.BackgroundColor3 = colors.accent; fill.Parent = bar; corner(fill)
    label(f, "Skill: " .. a.skill .. "  |  Consistency: " .. a.consistency .. "  |  Motivation: " .. a.motivation, 42)
    button(f, "Scout report — $100", function() request("Scout", {id = a.id}, true) end)
    if a.contract then
        local c = a.contract
        label(f, string.format("Net cash $%.2f/sec • %s\nRoyalty %d%% • %d min remaining", a.rate, a.event, c.royalty, math.max(0, math.ceil((c.expires - os.time()) / 60))), 58)
        for _, campaign in ipairs({{"Single", 200}, {"Album", 650}, {"Tour", 450}, {"Promote", 250}}) do
            local verb = campaign[1]
            button(f, verb .. " — $" .. campaign[2], function() request(verb, {id = a.id}, true) end)
        end
        if a.buyout then
            label(f, a.buyout.label .. " offers $" .. a.buyout.amount .. " for this contract.", 40)
            button(f, "Accept AI buyout", function() request("AcceptAI", {id = a.id}, true) end)
            button(f, "Decline AI buyout", function() request("RejectAI", {id = a.id}, true) end)
        end
    else
        label(f, "Contact via email / DM • Asking bonus $" .. a.asking .. " • Patience " .. a.patience, 42)
        drafts[a.id] = drafts[a.id] or {bonus = tostring(a.asking), royalty = "20", duration = "10", promotion = "100"}
        local d = drafts[a.id]
        local inputs = {}
        for _, item in ipairs({{"bonus", "Signing bonus ($)"}, {"royalty", "Artist royalty (0–80%)"}, {"duration", "Duration (5–60 minutes)"}, {"promotion", "Prepaid promotion commitment ($)"}}) do
            local key = item[1]
            inputs[key] = field(f, item[2], d[key], function(value) d[key] = value end)
        end
        button(f, "Send contract offer", function()
            local args = {id = a.id}
            for key, input in pairs(inputs) do d[key] = input.Text; args[key] = tonumber(input.Text) end
            request("Negotiate", args, true)
        end)
    end
end
render = function()
    for _, child in ipairs(content:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
    if not state then label(card(), "Loading…"); return end
    if tab == "Feed" or tab == "Roster" then
        if tab == "Feed" then button(card(), "Search social media for talent", function() request("Discover", {}, true) end) end
        local n = 0
        for _, a in ipairs(state.artists) do
            if (tab == "Roster" and a.contract) or (tab == "Feed" and not a.contract) then artistCard(a); n = n + 1 end
        end
        if n == 0 then label(card(), tab == "Feed" and "Search your feed or visit discovery booths around town." or "No signed artists yet.", 48) end
    elseif tab == "Studio" then
        local f = card()
        label(f, "Start with broken equipment and one artist slot. Repairs improve recording quality and capacity.", 60)
        button(f, state.studioCost and "Repair / upgrade studio — $" .. state.studioCost or "Studio fully upgraded", function() request("Studio", {}, true) end)
        button(f, state.scoutCost and "Upgrade scouting — $" .. state.scoutCost or "Scouting fully upgraded", function() request("ScoutUpgrade", {}, true) end)
        label(f, "Genre trends change each minute:", 32)
        for genre, trend in pairs(state.trends) do label(f, genre .. ": " .. math.floor(trend * 100) .. "% demand", 28) end
        label(f, "Promotion is paid upfront. Earnings can be negative. Rates update every minute; cash updates each second. Expired artists can negotiate again. Insolvent empty labels earn recovery income.", 100)
    elseif tab == "Inbox" then
        for _, b in ipairs(state.bids) do
            local f = card(); label(f, b.buyer .. " offers $" .. b.amount .. " for " .. b.name, 48)
            button(f, "Accept transfer", function() request("AcceptBid", {id = b.id}, true) end)
            button(f, "Decline", function() request("RejectBid", {id = b.id}, true) end)
        end
        for _, message in ipairs(state.messages) do label(card(), message, 64) end
    elseif tab == "Market" then
        label(card(), state.playerTrades and "Marketplace: transfers keep royalties and expiration. Seller approval is required. Offers expire after 2 minutes." or "Marketplace currently unavailable.", 100)
        for _, listing in ipairs(state.marketplace) do
            local f = card()
            label(f, listing.name .. " / " .. listing.label .. " / Popularity " .. listing.popularity, 42)
            label(f, "Royalty " .. listing.contract.royalty .. "% • " .. math.max(0, math.ceil((listing.contract.expires - os.time()) / 60)) .. " minutes remaining", 36)
            if state.playerTrades then
                local input = field(f, "Buyout offer ($)", 2000, function() end)
                button(f, "Send offer", function() request("Bid", {id = listing.id, owner = listing.owner, amount = tonumber(input.Text)}, true) end)
            end
        end
    end
end
for _, name in ipairs({"Feed", "Roster", "Studio", "Inbox", "Market"}) do
    local b = button(tabs, name, function() tab = name; content.CanvasPosition = Vector2.new(); request("State", {}, true) end)
    b.Size = UDim2.new(0.2, -4, 1, 0)
end
request("State", {}, true)
task.spawn(function()
    while true do
        task.wait(2)
        -- Keep editable forms stable while refreshing cash and server state.
        request("State", {}, not state)
        if frame.Visible and (tab == "Inbox" or tab == "Studio" or tab == "Roster") and not UIS:GetFocusedTextBox() then render() end
    end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
